<!--<script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"></script>-->
<!--<link href="https://cdn.jsdelivr.net/npm/select2@4.0.12/dist/css/select2.min.css" rel="stylesheet"/>-->
<!--<script src="https://cdn.jsdelivr.net/npm/select2@4.0.12/dist/js/select2.min.js"></script>-->


<script>

    $(document).ready(function () {
        $('#student_field').hide()
    });

    var value1 = 0;
    $('#batch_limit').change(function () {
        value1 = $('#batch_limit').val();
        limit(value1)
    })

    $("#student_select").click(function () {
        value1 = $('#batch_limit').val();
    });

    $('#course_name').change(function () {
        let course_id = $(this).val();
        $('#students').empty();
        student(course_id);



    });
    function student(course_id){
        $.ajax({
            url: '<?php echo base_url("admin/batch_model_form/course_wise_users/");?>' + course_id,
            dataType: 'json',
            success: function (data) {
                for (var key in data) {
                    if (data === "") {
                        $('#student_field').hide()
                    } else {
                        $('#student_field').show()

                        let id = data[key].split(',')
                        let student_dropdown = `<option value="${id[1]}">${id[0]}</option>`;
                        $('#students').append(student_dropdown)
                    }
                }
            }
        });


    }
    function limit(limit){

        // new SlimSelect({
        //     select: '#students',
        // })

        $('#student_select .select2').select2({
            multiple: "multiple",
            maximumSelectionLength: limit,
            language: {
                maximumSelected: (args) => args.maximum +' Your Student of Limit Full'
            },
        });
    }



</script>
